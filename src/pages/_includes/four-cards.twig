<section class="four-cards" id="servicios">
  <div class="info-block">
    <div class="info-item" data-text="texto1">
      <div class="icon-container icon-container--large">
        <img src="../../assets/images/diagnosis.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">DIAGNOSIS</p>
    </div>
    <div class="info-item" data-text="texto2">
      <div class="icon-container icon-container--large">
        <img src="../../assets/images/analisis.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">ANÁLISIS</p>
    </div>
    <div class="info-item" data-text="texto3">
      <div class="icon-container">
        <img src="../../assets/images/vacuna.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">VACUNACIÓN</p>
    </div>
    <div class="info-item" data-text="texto4">
      <div class="icon-container">
        <img src="../../assets/images/desparasitacion2.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">TRATAMIENTO</p>
    </div>
  </div>

  <div class="area-texto">
    {% for item in textos_iconos %}
      <div class="texto-bloque {{ item.id }}" style="display: {% if loop.first %}block{% else %}none{% endif %};">
        <h3 class="titulo-superior">{{ item.titulo }}</h3>
        <div class="texto-lado">
          <p>{{ item.texto }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
