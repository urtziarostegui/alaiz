<section class="about-us" id="sobre-nosotros">
  <div class="about-container">
    <div class="about-content">
      <h2 class="about-title">Sobre nosotros</h2>
      <div class="about-text">
        <p>Somos una clínica veterinaria de barrio con más de 15 años cuidando de las mascotas de Beriáin y alrededores. Nuestro equipo está formado por veterinarios apasionados que tratan a cada animal como si fuera de la familia.</p>
        <p>Creemos que la mejor medicina es la que combina experiencia profesional con un trato cercano y personalizado. Por eso, nos tomamos el tiempo de conocer a cada mascota y a sus dueños.</p>
      </div>
      <div class="about-features">
        <div class="feature">
          <i class="fas fa-heart"></i>
          <h3>Cariño</h3>
          <p>Tratamos a tu mascota con el mismo amor que tú</p>
        </div>
        <div class="feature">
          <i class="fas fa-clock"></i>
          <h3>Disponibilidad</h3>
          <p>Horarios flexibles y urgencias 24h</p>
        </div>
        <div class="feature">
          <i class="fas fa-home"></i>
          <h3>Cercanía</h3>
          <p>En el corazón de Beriáin, siempre cerca de ti</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="four-cards" id="servicios">
  <div class="services-header">
    <h2 class="services-title">Nuestros Servicios</h2>
    <p class="services-subtitle">Cuidamos de tu mascota con profesionalidad y cariño</p>
  </div>
  <div class="info-block">
    <div class="info-item" data-text="texto1">
      <div class="icon-container icon-container--large">
        <img src="../../assets/images/diagnosis.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">DIAGNOSIS</p>
    </div>
    <div class="info-item" data-text="texto2">
      <div class="icon-container icon-container--large">
        <img src="../../assets/images/analisis.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">ANÁLISIS</p>
    </div>
    <div class="info-item" data-text="texto3">
      <div class="icon-container">
        <img src="../../assets/images/vacuna.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">VACUNACIÓN</p>
    </div>
    <div class="info-item" data-text="texto4">
      <div class="icon-container">
        <img src="../../assets/images/desparasitacion2.svg" alt="Check Circle Icon" class="icon" />
      </div>
      <p class="info-text">TRATAMIENTO</p>
    </div>
  </div>

  <div class="area-texto">
    {% for item in textos_iconos %}
      <div class="texto-bloque {{ item.id }}" style="display: {% if loop.first %}block{% else %}none{% endif %};">
        <h3 class="titulo-superior">{{ item.titulo }}</h3>
        <div class="texto-lado">
          <p>{{ item.texto }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section class="contact-section" id="contacto">
  <div class="contact-container">
    <h2 class="contact-title">Contacto</h2>
    <div class="contact-content">
      <div class="contact-info">
        <div class="contact-item">
          <i class="fas fa-map-marker-alt"></i>
          <div>
            <h3>Dirección</h3>
            <p>Av. Pamplona 0<br>Beriáin (Navarra)</p>
          </div>
        </div>
        <div class="contact-item">
          <i class="fas fa-phone"></i>
          <div>
            <h3>Teléfono</h3>
            <p><a href="tel:+34679575468">679 57 54 68</a></p>
          </div>
        </div>
        <div class="contact-item">
          <i class="fas fa-envelope"></i>
          <div>
            <h3>Email</h3>
            <p><a href="mailto:info@veterinariaberiain.com">info@veterinariaberiain.com</a></p>
          </div>
        </div>
      </div>
      <div class="contact-hours">
        <h3>Horarios</h3>
        <div class="hours-grid">
          <div class="day">
            <span>Lunes - Viernes</span>
            <span>9:00 - 20:00</span>
          </div>
          <div class="day">
            <span>Sábados</span>
            <span>9:00 - 14:00</span>
          </div>
          <div class="day">
            <span>Domingos</span>
            <span>Cerrado</span>
          </div>
        </div>
        <p class="emergency">🆘 <strong>Urgencias 24h</strong> - Siempre disponibles para emergencias</p>
      </div>
    </div>
  </div>
</section>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@900&display=swap" rel="stylesheet">
